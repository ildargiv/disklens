# Normalize line endings: Go sources must be LF everywhere
# (gofmt considers CRLF files unformatted, and CI runs gofmt on Windows).
* text=auto
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
.gitignore text
LICENSE text
